{
  "manifest_version": 3,
  "name": "Bunpro Italian Assistant",
  "version": "1.1.1",
  "description": "Aggiunge traduzioni italiane alle schermate Learn e Review di Bunpro.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://bunpro.jp/*",
    "https://www.bunpro.jp/*",
    "https://api.mymemory.translated.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://bunpro.jp/*", "https://www.bunpro.jp/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bunpro Italian Assistant",
    "default_popup": "popup.html"
  }
}
